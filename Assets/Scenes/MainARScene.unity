  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: Karna (Adipati Karna / Suryaputra) adalah putra Kunti dengan Batara Surya, lahir sebelum Kunti menikah dan dihanyutkan di sungai. Ia dibesarkan Adirata, seorang kusir, lalu diangkat Duryodana menjadi raja Awangga. Karena balas budi, ia setia pada Kurawa meski tahu Pandawa adalah saudaranya. Ia gugur oleh Arjuna di Baratayuda.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 1969021004}
