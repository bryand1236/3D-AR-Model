  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc842f1ef1431f74485c87424341d774, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LanguageSwitcher
  descriptionTextMesh: {fileID: 1738269180}
  titleTextMesh: {fileID: 1799241079}
  buttonText: {fileID: 0}
  language1Font: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  language2Font: {fileID: 11400000, guid: c2d6c356338e9204ba4ddf98311de2ae, type: 2}
  language3Font: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  language1Text: Arjuna (Janaka / Permadi) adalah ksatria gagah perkasa putra ketiga Pandawa (penengah Pandawa). Ia dikenal berparas tampan, sakti mandraguna, dan mahir memanah. Memiliki pusaka sakti panah Pasopati. Berwatak ksatria, teguh pada kebenaran, dan rela berkorban.
  language1Title: Wayang Arjuna
  language2Text: "\uA983\uA982\uA997\uA9B8\uA9A4 (\uA997\uA9A4\uA98F \uA9A5\uA982\uA9AE\uA9A2\uA9C0) \uA9B2\uA9A2\uA9AD\uA983 \uA98F\uA9B8\uA9A0\uA9BF \uA9A5\uA9B8\uA9A0\uA9BF \uA9A2\uA9BA\uA9AE\uA9B6 \uA9A5\uA9A4\uA9C0\uA9A2\uA9AE\uA9C9 \uA9B2\uA9B6\uA9AA \uA9A5\uA9BA\uA9A4\uA9B1\uA9B6\uA9B2\uA9A0\uA9C0 \uA9A0\uA9BA\uA992\uA98F\uA9C0\uA99A \uA9A2\uA9A4\uA9C0 \uA98F\uA9BA\uA9A7\uA9BA\uA9A4\uA9AB\uA9A4\uA9C0\uA9C9"
  language2Title: "\uA9AE\uA9AA\uA981 \uA983\uA982\uA997\uA9B8\uA9A4"
  language3Text: Arjuna (Janaka / Permadi) is the handsome and peerless third brother of the Pandawas. Renowned as the greatest archer possessing the divine Pasopati arrow, he embodies chivalry, nobility, steadfast virtue, and self-sacrifice.
  language3Title: Wayang Arjuna
  buttonTextMesh: {fileID: 281361538}
  buttonTextLang1: English
  buttonTextLang2: Aksara Jawa
  buttonTextLang3: Bahasa Indonesia
  currentLanguageIndex: 0
